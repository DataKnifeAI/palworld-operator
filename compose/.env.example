# Copy to .env and edit before `make compose-up`:
#   cp compose/.env.example compose/.env
# Do not commit compose/.env (gitignored).

# Official Pocketpair image — pin a version tag so Steam clients stay compatible
# Tags: https://github.com/pocketpairjp/palworld-dedicated-server-docker/pkgs/container/palserver
PALSERVER_IMAGE=ghcr.io/pocketpairjp/palserver:v1.0.4.102642

# Server Manager sidecar. Default builds this repo’s Dockerfile as palworld-operator:compose
# (does not overwrite harbor.dataknife.net/library/palworld-operator:latest).
# To use Harbor instead: SERVER_MANAGER_IMAGE=harbor.dataknife.net/library/palworld-operator:latest
SERVER_MANAGER_IMAGE=palworld-operator:compose
SERVER_MANAGER_PORT=8088
SERVER_MANAGER_USER=admin
# REST from the sidecar on the compose network (game service name)
SERVER_MANAGER_REST_BASE=http://palworld-server:8212
# Match the host user that owns compose/Mods (laptop bind-mounts)
SIDECAR_UID=1000
SIDECAR_GID=1000
SIDECAR_MEM_LIMIT=128m
SIDECAR_CPU_LIMIT=0.25

# Host ports (container always listens on 8211 / 27015 / 8212 / 25575 / 8088)
GAME_PORT=8211
QUERY_PORT=27015
REST_PORT=8212
RCON_PORT=25575

# Resource caps for a minimal PC / laptop (raise if the container is OOM-killed)
MEM_LIMIT=6g
CPU_LIMIT=4.0
SHM_SIZE=1gb

# Seeded into Saved/Config/LinuxServer/PalWorldSettings.ini on first start only
# (existing INI is never overwritten — edit the file or delete it to re-seed)
SERVER_NAME="Palworld Local"
SERVER_DESCRIPTION="Local PC compose — no Kubernetes"
MAX_PLAYERS=4
SERVER_PASSWORD="change-me-join"
ADMIN_PASSWORD="change-me-admin"
RCON_ENABLED=True
REST_API_ENABLED=True
CROSSPLAY_PLATFORMS="(Steam,Xbox,PS5,Mac)"
